{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "npm run start --workspace server",
    "healthcheckPath": "/api/artikel",
    "restartPolicyType": "ON_FAILURE"
  }
}
